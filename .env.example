# ============================================================
# Пример .env для docker compose.
# Скопируйте в .env и отредактируйте при необходимости:
#   cp .env.example .env
# Значения из .env автоматически подхватываются docker compose и
# переопределяют значения по умолчанию в docker-compose.yml.
# Если .env не создавать — будут использованы значения по умолчанию.
# ============================================================

# --- Ollama преподавателя ---

# Имя модели для грейдинга релевантности и расширения запроса.
# Модель должна быть установлена локально:  ollama pull <имя>
OLLAMA_MODEL=qwen2.5:3b

# Адрес OpenAI-совместимого API Ollama на хосте.
# Windows/macOS (Docker Desktop): работает по умолчанию.
# Linux: требуется запуск Ollama с OLLAMA_HOST=0.0.0.0 (см. README).
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# --- Сервер ---

# Порт, на котором MCP-сервер доступен агенту: http://localhost:<порт>
RAG_MCP_PORT=6543