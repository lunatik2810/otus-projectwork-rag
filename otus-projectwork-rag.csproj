<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64;osx-arm64;linux-x64;linux-arm64;linux-musl-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>f9f7cd85-8ee7-4d06-a491-aa9a0ccb4aeb</UserSecretsId>


    <!--
      Self-contained single-file публикация выполняется параметрами dotnet publish:
        dotnet publish -p:SelfContained=true -p:PublishSingleFile=true
      В csproj эти свойства не задаются: иначе проект нельзя подключить из тестовой
      сборки (NETSDK1151 — неавтономный проект не может ссылаться на автономный exe).
    -->

    <!--
      Извлекает native-библиотеки (ONNX Runtime) в отдельные файлы при запуске,
      иначе single-file публикация не сможет загрузить onnxruntime в рантайме.
      Учитывается только при single-file публикации.
    -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <Platforms>AnyCPU;x64</Platforms>

    <!--
      exe-проекты по умолчанию не создают ref-сборку (obj\<config>\<tfm>\ref\),
      из-за чего тестовый проект не находит метаданные для компиляции против
      основных типов. Включаем генерацию явно.
    -->
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="DataBaseRAG\**" />
    <Content Remove="DataBaseRAG\**" />
    <EmbeddedResource Remove="DataBaseRAG\**" />
    <None Remove="DataBaseRAG\**" />
  </ItemGroup>

  <!--
    Default-глоб **/*.cs захватывает и тестовый проект (исходники + сгенерированные
    файлы из его obj/bin): иначе основной проект компилирует их вместе со своими
    типами (дубли атрибутов сборки, неизвестные Fact/Microsoft.Testing).
  -->
  <ItemGroup>
    <Compile Remove="Tests\**" />
    <Content Remove="Tests\**" />
    <EmbeddedResource Remove="Tests\**" />
    <None Remove="Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" Version="14.2.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.1.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Tokenizers.HuggingFace" Version="3.23.1" />
  </ItemGroup>

  <ItemGroup>
