    <Folder Include=".agents\skills\" />
    <Folder Include="ForTeachers\ExampleConfigs\" />
    <Folder Include="ForTeachers\Prompts\" />
    <Folder Include="ForTeachers\ToolOutputsContract\" />
  </ItemGroup>

